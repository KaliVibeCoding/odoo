<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ═══════════════════════════════════════════════════════════
       KVC PROGRAM VIEWS
  ════════════════════════════════════════════════════════════ -->

  <!-- Program list -->
  <record id="view_kvc_program_list" model="ir.ui.view">
    <field name="name">kvc.program.list</field>
    <field name="model">kvc.program</field>
    <field name="arch" type="xml">
      <list string="KVC Programs" decoration-success="state == 'active'" decoration-muted="not active">
        <field name="code" optional="show"/>
        <field name="name"/>
        <field name="program_type"/>
        <field name="funding_source"/>
        <field name="start_date"/>
        <field name="end_date"/>
        <field name="duration_weeks"/>
        <field name="cohort_count"/>
        <field name="price" widget="monetary"/>
        <field name="active" invisible="1"/>
      </list>
    </field>
  </record>

  <!-- Program form -->
  <record id="view_kvc_program_form" model="ir.ui.view">
    <field name="name">kvc.program.form</field>
    <field name="model">kvc.program</field>
    <field name="arch" type="xml">
      <form string="KVC Program">
        <header>
          <button name="%(action_kvc_cohort_list)d" type="action"
                  string="View Cohorts" class="btn-secondary"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="%(action_kvc_cohort_list)d" type="action"
                    class="oe_stat_button" icon="fa-users">
              <field name="cohort_count" widget="statinfo" string="Cohorts"/>
            </button>
          </div>
          <div class="oe_title">
            <label for="name" string="Program"/>
            <h1><field name="name" placeholder="Program Name"/></h1>
            <div class="o_row">
              <field name="code" readonly="1" class="oe_read_only"/>
              <field name="active" widget="boolean_toggle"/>
            </div>
          </div>
          <group>
            <group string="Classification">
              <field name="program_type"/>
              <field name="naics_code"/>
              <field name="funding_source"/>
            </group>
            <group string="Schedule">
              <field name="start_date"/>
              <field name="end_date"/>
              <field name="duration_weeks" readonly="1"/>
              <field name="max_students"/>
            </group>
          </group>
          <group>
            <group string="Pricing">
              <field name="currency_id" invisible="1"/>
              <field name="price" widget="monetary"/>
              <field name="stripe_price_id"/>
            </group>
            <group string="GoHighLevel">
              <field name="ghl_pipeline_id"/>
              <field name="ghl_stage_id"/>
            </group>
          </group>
          <notebook>
            <page string="Description">
              <field name="description" widget="html"/>
            </page>
            <page string="Outcomes &amp; Prerequisites">
              <group>
                <field name="outcomes" nolabel="1" placeholder="Learning outcomes..."/>
                <field name="prerequisites" nolabel="1" placeholder="Prerequisites..."/>
                <field name="tech_stack" placeholder="Next.js, Python, Cloudflare..."/>
              </group>
            </page>
            <page string="Schedule Notes">
              <field name="schedule_notes"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <!-- Program kanban -->
  <record id="view_kvc_program_kanban" model="ir.ui.view">
    <field name="name">kvc.program.kanban</field>
    <field name="model">kvc.program</field>
    <field name="arch" type="xml">
      <kanban default_group_by="program_type" class="o_kanban_small_column">
        <field name="name"/>
        <field name="program_type"/>
        <field name="start_date"/>
        <field name="end_date"/>
        <field name="cohort_count"/>
        <field name="price"/>
        <field name="color"/>
        <templates>
          <t t-name="kanban-box">
            <div t-attf-class="oe_kanban_card oe_kanban_global_click o_kanban_record_has_image_fill" t-attf-style="border-left: 3px solid var(--kvc-pink)">
              <div class="o_kanban_record_top">
                <div class="o_kanban_record_headings">
                  <strong class="o_kanban_record_title">
                    <field name="name"/>
                  </strong>
                </div>
              </div>
              <div class="o_kanban_record_body">
                <field name="start_date"/> – <field name="end_date"/>
                <div class="mt-1">
                  <span class="badge rounded-pill bg-primary">
                    <field name="cohort_count"/> cohorts
                  </span>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- Program action -->
  <record id="action_kvc_program_list" model="ir.actions.act_window">
    <field name="name">KVC Programs</field>
    <field name="res_model">kvc.program</field>
    <field name="view_mode">list,kanban,form</field>
    <field name="context">{}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Create your first KVC training program.
      </p>
    </field>
  </record>

  <!-- ═══════════════════════════════════════════════════════════
       KVC COHORT VIEWS
  ════════════════════════════════════════════════════════════ -->

  <record id="view_kvc_cohort_list" model="ir.ui.view">
    <field name="name">kvc.cohort.list</field>
    <field name="model">kvc.cohort</field>
    <field name="arch" type="xml">
      <list string="KVC Cohorts"
            decoration-success="state == 'active'"
            decoration-info="state == 'open'"
            decoration-muted="state in ('completed','cancelled')">
        <field name="name"/>
        <field name="program_id"/>
        <field name="state" widget="badge"/>
        <field name="start_date"/>
        <field name="end_date"/>
        <field name="student_count"/>
        <field name="seats_remaining"/>
        <field name="instructor_id"/>
      </list>
    </field>
  </record>

  <record id="view_kvc_cohort_form" model="ir.ui.view">
    <field name="name">kvc.cohort.form</field>
    <field name="model">kvc.cohort</field>
    <field name="arch" type="xml">
      <form string="KVC Cohort">
        <header>
          <button name="action_open" string="Open Enrollment" type="object"
                  invisible="state != 'draft'" class="btn-primary"/>
          <button name="action_activate" string="Start Cohort" type="object"
                  invisible="state != 'open'" class="btn-primary"/>
          <button name="action_complete" string="Mark Complete" type="object"
                  invisible="state != 'active'"/>
          <button name="action_cancel" string="Cancel" type="object"
                  invisible="state in ('completed','cancelled')"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="draft,open,active,completed"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button type="object" name="action_view_students" class="oe_stat_button" icon="fa-graduation-cap">
              <field name="student_count" widget="statinfo" string="Students"/>
            </button>
          </div>
          <div class="oe_title">
            <h1><field name="name" placeholder="Cohort Name"/></h1>
          </div>
          <group>
            <group>
              <field name="program_id"/>
              <field name="instructor_id"/>
              <field name="meeting_link"/>
            </group>
            <group>
              <field name="start_date"/>
              <field name="end_date"/>
              <field name="seats_remaining" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="Students">
              <field name="student_ids">
                <list>
                  <field name="partner_id"/>
                  <field name="state" widget="badge"/>
                  <field name="enrollment_date"/>
                  <field name="progress_pct" widget="progressbar"/>
                  <field name="payment_status" widget="badge"/>
                </list>
              </field>
            </page>
            <page string="Notes">
              <field name="notes"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_kvc_cohort_list" model="ir.actions.act_window">
    <field name="name">KVC Cohorts</field>
    <field name="res_model">kvc.cohort</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- ═══════════════════════════════════════════════════════════
       KVC STUDENT VIEWS
  ════════════════════════════════════════════════════════════ -->

  <record id="view_kvc_student_list" model="ir.ui.view">
    <field name="name">kvc.student.list</field>
    <field name="model">kvc.student</field>
    <field name="arch" type="xml">
      <list string="KVC Students"
            decoration-success="state == 'completed'"
            decoration-info="state == 'active'"
            decoration-muted="state in ('dropped','cancelled')">
        <field name="partner_id"/>
        <field name="program_id"/>
        <field name="cohort_id"/>
        <field name="state" widget="badge"/>
        <field name="enrollment_date"/>
        <field name="progress_pct" widget="progressbar"/>
        <field name="payment_status" widget="badge"/>
        <field name="certificate_issued" widget="boolean"/>
      </list>
    </field>
  </record>

  <record id="view_kvc_student_form" model="ir.ui.view">
    <field name="name">kvc.student.form</field>
    <field name="model">kvc.student</field>
    <field name="arch" type="xml">
      <form string="KVC Student Enrollment">
        <header>
          <button name="action_enroll" string="Enroll" type="object"
                  invisible="state not in ('inquiry','applied')" class="btn-primary"/>
          <button name="action_activate" string="Mark Active" type="object"
                  invisible="state != 'enrolled'"/>
          <button name="action_complete" string="Complete" type="object"
                  invisible="state != 'active'" class="btn-primary"/>
          <button name="action_issue_certificate" string="Issue Certificate" type="object"
                  invisible="state != 'completed' or certificate_issued"/>
          <button name="action_drop" string="Drop" type="object"
                  invisible="state in ('completed','dropped','cancelled')"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="inquiry,applied,enrolled,active,completed"/>
        </header>
        <sheet>
          <div class="oe_title">
            <label for="partner_id" string="Student"/>
            <h1><field name="partner_id" placeholder="Select student..."/></h1>
          </div>
          <group>
            <group string="Enrollment">
              <field name="cohort_id"/>
              <field name="program_id" readonly="1"/>
              <field name="enrollment_date"/>
              <field name="completion_date"/>
            </group>
            <group string="Progress">
              <field name="progress_pct" widget="progressbar"/>
              <field name="grade"/>
              <field name="certificate_issued"/>
              <field name="certificate_date" invisible="not certificate_issued"/>
            </group>
          </group>
          <group>
            <group string="Funding &amp; Payment">
              <field name="funding_source" readonly="1"/>
              <field name="currency_id" invisible="1"/>
              <field name="scholarship_amount" widget="monetary"/>
              <field name="payment_status"/>
              <field name="stripe_customer_id"/>
            </group>
            <group string="GoHighLevel Sync">
              <field name="ghl_contact_id"/>
              <field name="ghl_opportunity_id"/>
            </group>
          </group>
          <notebook>
            <page string="Notes">
              <field name="notes"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_kvc_student_list" model="ir.actions.act_window">
    <field name="name">All Students</field>
    <field name="res_model">kvc.student</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="action_kvc_student_active" model="ir.actions.act_window">
    <field name="name">Active Enrollments</field>
    <field name="res_model">kvc.student</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('state','in',['enrolled','active'])]</field>
  </record>

</odoo>
