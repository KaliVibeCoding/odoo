<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kvc_program_tree" model="ir.ui.view">
        <field name="name">kvc.program.tree</field>
        <field name="model">kvc.program</field>
        <field name="arch" type="xml">
            <list string="Programs">
                <field name="code"/>
                <field name="name"/>
                <field name="level"/>
                <field name="duration_weeks"/>
                <field name="tuition_fee"/>
                <field name="total_cohorts"/>
                <field name="total_students"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_kvc_program_form" model="ir.ui.view">
        <field name="name">kvc.program.form</field>
        <field name="model">kvc.program</field>
        <field name="arch" type="xml">
            <form string="Program">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Program Name e.g. Full-Stack AI Agentic Developer"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="level"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="duration_weeks"/>
                            <field name="tuition_fee"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Overview &amp; Syllabus">
                            <field name="description"/>
                        </page>
                        <page string="Cohorts">
                            <field name="cohort_ids">
                                <list string="Cohorts">
                                    <field name="name"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="enrolled_count"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kvc_program" model="ir.actions.act_window">
        <field name="name">Certification Programs</field>
        <field name="res_model">kvc.program</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
