<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kvc_student_tree" model="ir.ui.view">
        <field name="name">kvc.student.tree</field>
        <field name="model">kvc.student</field>
        <field name="arch" type="xml">
            <list string="Students">
                <field name="name"/>
                <field name="email"/>
                <field name="program_id"/>
                <field name="cohort_id"/>
                <field name="progress_percentage" widget="progressbar"/>
                <field name="certification_status"/>
                <field name="career_placement_status"/>
            </list>
        </field>
    </record>

    <record id="view_kvc_student_kanban" model="ir.ui.view">
        <field name="name">kvc.student.kanban</field>
        <field name="model">kvc.student</field>
        <field name="arch" type="xml">
            <kanban default_group_by="certification_status">
                <field name="name"/>
                <field name="email"/>
                <field name="program_id"/>
                <field name="progress_percentage"/>
                <field name="certification_status"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click p-3 rounded-lg shadow border border-primary">
                            <div class="fw-bold text-primary fs-5"><field name="name"/></div>
                            <div class="text-muted"><field name="email"/></div>
                            <div class="mt-2"><strong>Program:</strong> <field name="program_id"/></div>
                            <div class="mt-1">
                                <field name="progress_percentage" widget="progressbar"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_kvc_student_form" model="ir.ui.view">
        <field name="name">kvc.student.form</field>
        <field name="model">kvc.student</field>
        <field name="arch" type="xml">
            <form string="Student Profile">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="partner_id" placeholder="Select Contact / Lead"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="program_id"/>
                            <field name="cohort_id"/>
                            <field name="crm_lead_id"/>
                        </group>
                        <group>
                            <field name="progress_percentage" widget="progressbar"/>
                            <field name="attendance_rate"/>
                            <field name="certification_status"/>
                            <field name="career_placement_status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Evaluation &amp; Notes">
                            <field name="notes" placeholder="Instructor notes, milestones, certifications earned..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kvc_student" model="ir.actions.act_window">
        <field name="name">Student Roster</field>
        <field name="res_model">kvc.student</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
