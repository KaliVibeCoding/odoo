<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kvc_cohort_tree" model="ir.ui.view">
        <field name="name">kvc.cohort.tree</field>
        <field name="model">kvc.cohort</field>
        <field name="arch" type="xml">
            <list string="Cohorts">
                <field name="name"/>
                <field name="program_id"/>
                <field name="instructor_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="enrolled_count"/>
                <field name="max_capacity"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_kvc_cohort_form" model="ir.ui.view">
        <field name="name">kvc.cohort.form</field>
        <field name="model">kvc.cohort</field>
        <field name="arch" type="xml">
            <form string="Cohort">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Fall 2026 AI Cohort #1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="program_id"/>
                            <field name="instructor_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="max_capacity"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Student Roster">
                            <field name="student_ids">
                                <list string="Students">
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="progress_percentage"/>
                                    <field name="certification_status"/>
                                    <field name="career_placement_status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kvc_cohort" model="ir.actions.act_window">
        <field name="name">Student Cohorts</field>
        <field name="res_model">kvc.cohort</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
